# Copy this file to .env and fill in ONE provider. .env is in .gitignore - never commit it.
# Any OpenAI-compatible provider works: set the key, base URL and model name.

# --- Option A: Groq (free tier) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# --- Option B: Google Gemini (free tier via Google AI Studio) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.8-flash

# --- Option C: OpenAI ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
